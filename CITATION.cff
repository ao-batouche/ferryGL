    given-names: Oussama
version: 0.2.1
date-released: 2026-10-16
license: MIT
repository-code: "https://github.com/ao-batouche/ferryGL"
url: "https://oussamabatouche.com/ferryGL/"
keywords:
  - issue tracking
  - synchronization
  - token-free automation
  - token-free synchronization
  - AI agents
  - LLM agents
  - inference cost
  - deterministic automation
  - GitHub
  - Linear
  - least privilege
